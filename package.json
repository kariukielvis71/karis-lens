{
  "name": "studio-edge-app",
  "version": "1.0.0",
  "description": "Core logic and infrastructure layer for a modular vanilla JS app on Cloudflare D1 + R2.",
  "type": "module",
  "main": "src/app.js",
  "scripts": {
    "dev": "npx http-server . -p 8080 -c-1",
    "start": "npx http-server . -p 8080 -c-1",
    "pages:dev": "npx wrangler pages dev .",
    "pages:deploy": "npx wrangler pages deploy .",
    "d1:schema": "npx wrangler d1 execute karis-media-db --remote --file=./schema.sql",
    "d1:seed": "npx wrangler d1 execute karis-media-db --remote --file=./seed.sql"
  },
  "keywords": [
    "cloudflare",
    "d1",
    "r2",
    "vanilla-js",
    "whatsapp-integration"
  ],
  "license": "UNLICENSED"
}
